   "source": [
    "import numpy as np\n",
    "import math\n",
    "\n",
    "def leibniz(n):\n",
    "    pi_sum = 0.0\n",
    "    for j in range(n):\n",
    "        pi_sum += (-1)**j / (2*j + 1)\n",
    "    return 4 * pi_sum\n",
    "\n",
    "for i in range(100, 5001, 100):\n",
    "    estPI = leibniz(i)\n",
    "    relative_error = abs(estPI - math.pi) / math.pi\n",
    "    print( i, relative_error)\n"
   ]
